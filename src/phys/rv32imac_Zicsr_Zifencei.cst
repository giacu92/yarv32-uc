// Debug Leds
IO_LOC "led_o[3]" 18;
IO_PORT "led_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_o[2]" 17;
IO_PORT "led_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_o[1]" 16;
IO_PORT "led_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_o[0]" 15;
IO_PORT "led_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "rst_i" 88;
IO_PORT "rst_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// UART - onboard BL616 USB-UART bridge
IO_LOC "uart_txd_o" 69;
IO_PORT "uart_txd_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rxd_i" 70;
IO_PORT "uart_rxd_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// PIN80..85 (onboard microSD slot) are free: the SDIO controller that used
// them was dropped from this branch. Three of them now carry the I2S
// receiver.

// I2S receiver. BCLK and LRCK are BIDIRECTIONAL: the peripheral drives
// them in master mode (an INMP441 is itself a clock slave, so something
// has to) and releases them when an external device is the master, so they
// need DRIVE=8 as well as a pull. SD is data in, always an input.
// PULL_MODE=DOWN throughout, not UP: an unconnected or released bus then
// reads a static 0, which the receiver sees as "no BCLK" and therefore
// captures nothing -- whereas a floating pad would toggle and shift noise
// into the FIFO. The board top double-flops all three before the
// peripheral, and samples the PADS even in master mode.
IO_LOC "i2s_bclk_io" 80;
IO_PORT "i2s_bclk_io" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_lrck_io" 81;
IO_PORT "i2s_lrck_io" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_sd_i" 82;
IO_PORT "i2s_sd_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// I2C master. Open-drain lines: pin is driven low or released; PULL_MODE=UP
// gives the weak internal pull-up as a fallback, external pull-ups still
// required for real slaves.
IO_LOC "i2c_scl_io" 25;
IO_PORT "i2c_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "i2c_sda_io" 26;
IO_PORT "i2c_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// SPI master (mode 0-3, software chip-select). Outputs DRIVE=8, no pull;
// MISO gets a weak pull-up so an unconnected line reads idle-high instead of
// toggling with crosstalk.
IO_LOC "spi_sck_o" 27;
IO_PORT "spi_sck_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "spi_mosi_o" 28;
IO_PORT "spi_mosi_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "spi_miso_i" 29;
IO_PORT "spi_miso_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "spi_cs_n_o" 30;
IO_PORT "spi_cs_n_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// GPIO (4 bidirectional pins, free right-header IOs). Push-pull: DIR=1
// drives OUT onto the pad, DIR=0 releases it. PULL_MODE=UP so a released /
// unconnected pin reads a defined 1, matching the sim's loopback model —
// note the GPIO INT_TYPE resets to level-high, so firmware must W1C
// INT_STATUS (after setting the type to an edge) before arming
// interrupts (see sim/sw/peri/plic_gpio).
IO_LOC "gpio_io[0]" 41;
IO_PORT "gpio_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "gpio_io[1]" 42;
IO_PORT "gpio_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "gpio_io[2]" 71;
IO_PORT "gpio_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "gpio_io[3]" 72;
IO_PORT "gpio_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// 25 MHz reference clock from the MS5351M clock generator (crystal-fed).
// The MS5351M outputs three independent single-ended CMOS clocks; CLK0
// is routed to PIN10. Used as a plain 3.3V LVCMOS33 input — no
// differential pair, no LVDS primitive, no external termination.
IO_LOC "clk_i" 10;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
